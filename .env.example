# Opt-in only. Missing/partial keys or false means no SDK import or tracking.
VITE_GAMEANALYTICS_ENABLED=false
VITE_GAMEANALYTICS_GAME_KEY=
VITE_GAMEANALYTICS_SECRET_KEY=
# These must be the dedicated GAME collection keys for the browser SDK.
# VITE_* is public in built JavaScript. NEVER enter account/admin/server secrets.
# Do not commit actual values. See docs/remote-validation-v1.md before enabling.
# Build identity is generated automatically from Vercel/git commit at build time.
